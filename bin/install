#!/usr/bin/env bash
# Install a powerup skill (and the agents it needs) into a coding tool's config.
#
#   install <tool> <skill>
#
# tool  : which coding tool to install into (currently only "claude")
# skill : powerup | consult | design-doc | delivery | evolve
#         | queue-run | powerup-auto | test-filter-hook
#         "powerup" installs the whole bundle: all five skills + their agents.
#         "powerup-auto" is that bundle plus queue-run and its wrapper.
#
# pult calls this as `${module.dir}/bin/install {tool} {skill}`, so the repo
# root is the parent of this script's directory — resolved from $0, not cwd.
set -euo pipefail

tool="${1:-}"
skill="${2:-}"

script_dir="$(cd "$(dirname "$0")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

die() { echo "install: $*" >&2; exit 1; }

[ -n "$tool" ]  || die "no tool given (expected: claude)"
[ -n "$skill" ] || die "no skill given (expected: powerup | consult | design-doc | delivery | evolve | queue-run | powerup-auto | test-filter-hook)"

# One door, OS-native behind it. pult always runs this via `sh`, so on Linux and
# macOS the copy logic below is the whole story. On Windows (this runs under Git
# Bash — pult still needs `sh` there) route to the PowerShell installer so there
# is one audited Windows code path, the same one a user without Git Bash runs
# directly. Falls through to the copy logic everywhere else.
case "${OS:-}$(uname -s 2>/dev/null || true)" in
  *Windows_NT* | *MINGW* | *MSYS* | *CYGWIN*)
    ps=pwsh
    command -v pwsh >/dev/null 2>&1 || ps=powershell
    script="$script_dir/install.ps1"
    command -v cygpath >/dev/null 2>&1 && script=$(cygpath -w "$script")
    exec "$ps" -NoProfile -ExecutionPolicy Bypass -File "$script" "$tool" "$skill"
    ;;
esac

# --- Per-tool config layout -------------------------------------------------
case "$tool" in
  claude)
    src_skills="$repo_root/claude/skills"
    src_agents="$repo_root/claude/agents"
    src_bin="$repo_root/claude/bin"
    src_hooks="$repo_root/claude/hooks"
    dst_skills="$HOME/.claude/skills"
    dst_agents="$HOME/.claude/agents"
    dst_bin="$HOME/.claude/bin"
    dst_hooks="$HOME/.claude/hooks"
    ;;
  *)
    die "unknown tool '$tool' (only 'claude' is supported today)"
    ;;
esac

# --- Which skills + agents does this selection pull in? ---------------------
# Skills are copied as directories; agents as individual *.md files; bin and
# hook scripts as individual files. Hooks are copied but never wired in:
# settings.json is the user's, so the entry to add is printed instead.
advisors=(lonic-advisor-low lonic-advisor-medium lonic-advisor-high lonic-advisor-xhigh)
# Inert without tetel; design-doc routes to them only when it is installed.
design_passes=(lonic-design-attacker lonic-grounder)
bundle_skills=(powerup consult design-doc delivery evolve)
bundle_agents=("${advisors[@]}" "${design_passes[@]}")
skills=()
agents=()
bins=()
hooks=()
case "$skill" in
  powerup)
    skills=("${bundle_skills[@]}")
    agents=("${bundle_agents[@]}")
    bins=(wait-pr-ci)
    ;;
  powerup-auto)
    skills=("${bundle_skills[@]}" queue-run powerup-auto)
    agents=("${bundle_agents[@]}")
    bins=(wait-pr-ci)
    ;;
  consult)
    skills=(consult)
    agents=("${advisors[@]}")
    ;;
  design-doc)
    skills=(design-doc)
    agents=("${design_passes[@]}")
    ;;
  delivery)
    skills=(delivery)
    bins=(wait-pr-ci)
    ;;
  evolve|queue-run)
    skills=("$skill")
    ;;
  test-filter-hook)
    hooks=(filter-test-output.sh test-output-summary.sh)
    ;;
  *)
    die "unknown skill '$skill'"
    ;;
esac

# --- Copy -------------------------------------------------------------------
# Loops expand arrays as ${a[@]+"${a[@]}"}: macOS ships bash 3.2, where an empty
# array under `set -u` is an unbound-variable error.
mkdir -p "$dst_skills" "$dst_agents"
[ ${#bins[@]} -eq 0 ]  || mkdir -p "$dst_bin"
[ ${#hooks[@]} -eq 0 ] || mkdir -p "$dst_hooks"

for s in ${skills[@]+"${skills[@]}"}; do
  [ -d "$src_skills/$s" ] || die "skill '$s' not found at $src_skills/$s"
  rm -rf "${dst_skills:?}/$s"
  cp -R "$src_skills/$s" "$dst_skills/$s"
  echo "  skill  $s -> $dst_skills/$s"
done

for a in ${agents[@]+"${agents[@]}"}; do
  [ -f "$src_agents/$a.md" ] || die "agent '$a' not found at $src_agents/$a.md"
  cp "$src_agents/$a.md" "$dst_agents/$a.md"
  echo "  agent  $a -> $dst_agents/$a.md"
done

for b in ${bins[@]+"${bins[@]}"}; do
  [ -f "$src_bin/$b" ] || die "script '$b' not found at $src_bin/$b"
  cp "$src_bin/$b" "$dst_bin/$b"
  chmod +x "$dst_bin/$b"
  echo "  bin    $b -> $dst_bin/$b"
done

for h in ${hooks[@]+"${hooks[@]}"}; do
  [ -f "$src_hooks/$h" ] || die "hook '$h' not found at $src_hooks/$h"
  cp "$src_hooks/$h" "$dst_hooks/$h"
  chmod +x "$dst_hooks/$h"
  echo "  hook   $h -> $dst_hooks/$h"
done

echo
echo "Installed '$skill' for $tool."
if [ "$skill" = "powerup" ]; then
  echo "Start a session and run /powerup to switch on full-rigor mode."
elif [ "$skill" = "test-filter-hook" ]; then
  echo "Not active yet: add this to ~/.claude/settings.json (needs jq):"
  echo
  echo '  "hooks": { "PreToolUse": [ { "matcher": "Bash", "hooks": ['
  echo "    { \"type\": \"command\", \"command\": \"bash $dst_hooks/filter-test-output.sh\" }"
  echo '  ] } ] }'
elif [ "$skill" = "queue-run" ] || [ "$skill" = "powerup-auto" ]; then
  echo "Start a session and run /$skill stop at <N>%."
  echo "It hands off between items with the phase-handoff mod (see README, \"Mods\");"
  echo "without it, each session stops and prints the next session's prompt."
else
  echo "Start a session and enable it by name: /$skill"
fi
